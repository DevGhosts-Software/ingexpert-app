{
  "name": "@ingexpert/database",
  "version": "0.1.5",
  "description": "Prisma schema and generated Prisma Client for Ingexpert",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "prisma:dev": "dotenv -e .env.development -- prisma",
    "prisma:prod": "dotenv -e .env -- prisma",
    "db:generate": "pnpm db:generate:dev",
    "db:generate:dev": "pnpm prisma:dev -- generate",
    "db:generate:prod": "pnpm prisma:prod -- generate",
    "db:migrate": "pnpm db:migrate:dev",
    "db:migrate:dev": "pnpm prisma:dev -- migrate dev",
    "db:migrate:prod": "pnpm prisma:prod -- migrate deploy",
    "db:push": "pnpm db:push:dev",
    "db:push:dev": "pnpm prisma:dev -- db push",
    "db:push:prod": "pnpm prisma:prod -- db push",
    "db:deploy": "pnpm db:migrate:prod",
    "db:reset": "pnpm db:reset:dev",
    "db:reset:dev": "pnpm prisma:dev -- migrate reset --force",
    "db:reset:prod": "pnpm prisma:prod -- migrate reset --force",
    "db:init": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "db:seed": "pnpm db:init",
    "db:studio": "pnpm db:studio:dev",
    "db:studio:dev": "pnpm prisma:dev -- studio",
    "db:studio:prod": "pnpm prisma:prod -- studio",
    "supabase:link": "npx supabase link",
    "supabase:db:push": "npx supabase db push",
    "supabase:functions:deploy": "npx supabase functions deploy --no-verify-jwt",
    "supabase:deploy": "pnpm supabase:link && pnpm supabase:db:push && pnpm supabase:functions:deploy",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:tooling",
    "prettier": "catalog:tooling",
    "prisma": "catalog:prisma",
    "tsx": "^4.21.0",
    "typescript": "catalog:tooling",
    "typescript-eslint": "catalog:linting"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:prisma-client",
    "@prisma/client": "catalog:prisma-client",
    "@supabase/supabase-js": "^2.95.3",
    "pg": "^8.16.3"
  }
}
