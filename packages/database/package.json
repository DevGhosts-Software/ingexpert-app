{
  "name": "@ingexpert/database",
  "version": "0.1.0",
  "description": "Prisma schema and generated Prisma Client for Ingexpert",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "eslint": "catalog:tooling",
    "prettier": "catalog:tooling",
    "prisma": "catalog:prisma",
    "tsx": "^4.21.0",
    "typescript": "catalog:tooling",
    "typescript-eslint": "catalog:linting"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:prisma-client",
    "@prisma/client": "catalog:prisma-client",
    "@supabase/supabase-js": "^2.95.3",
    "pg": "^8.16.3"
  }
}
