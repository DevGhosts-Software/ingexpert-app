# Connect to Supabase via connection pooling. Used for transactions
DATABASE_URL="postgresql://db_user:db_pass@db-host.pooler.example.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://db_user:db_pass@db-host.example.com:5432/postgres"

# Supabase configuration for seed script
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"