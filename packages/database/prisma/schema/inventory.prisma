enum ItemType {
  PRODUCT
  EQUIPMENT
  TOOL
  KIT
}

model Item {
  id       String   @id @default(uuid())
  name     String   @map("nombre")
  location String   @map("ubicacion")
  stock    Decimal  @default(0) @db.Decimal(10, 2) @map("stock")
  unit     String   @map("unidad")
  type     ItemType @map("tipo")

  // Relations
  disposal      Disposal?
  kitComponents KitDetail[] @relation("KitToComponent")
  asComponentOf KitDetail[] @relation("ComponentToKit")
  movementDetails MovementDetail[]

  @@map("items")
}

model KitDetail {
  id          String  @id @default(uuid())
  kitId       String  @map("id_kit")
  componentId String  @map("id_item")
  quantity    Decimal @db.Decimal(10, 2) @map("cantidad")

  kit       Item @relation("KitToComponent", fields: [kitId], references: [id])
  component Item @relation("ComponentToKit", fields: [componentId], references: [id])

  @@unique([kitId, componentId])
  @@map("kit_details")
}

model Disposal {
  id            String   @id @map("id")
  item          Item     @relation(fields: [id], references: [id])
  date          DateTime @map("fecha")
  reason        String   @map("motivo")
  status        String   @map("estado")
  responsibleId String   @map("id_responsable")
  responsible   Staff    @relation(fields: [responsibleId], references: [id])
  observations  String?  @map("observaciones")
  actions       String?  @map("acciones")

  @@map("disposals")
}
