enum ItemType {
  PRODUCT
  EQUIPMENT
  TOOL
  KIT
}

model Item {
  id        String   @id @default(uuid())
  name      String   @map("name")
  location  String   @map("location")
  stock     Decimal  @default(0) @map("stock") @db.Decimal(10, 2)
  unit      String   @map("unit")
  type      ItemType @map("type")
  image_url String   @map("image_url")

  // Relations
  disposal        Disposal?
  kitDetails      KitDetail[]      @relation("KitToComponent")
  asComponentOf   KitDetail[]      @relation("ComponentToKit")
  movementDetails MovementDetail[]

  @@map("items")
}

model KitDetail {
  id          String  @id @default(uuid())
  kitId       String  @map("kit_id")
  componentId String  @map("item_id")
  quantity    Decimal @map("quantity") @db.Decimal(10, 2)

  kit       Item @relation("KitToComponent", fields: [kitId], references: [id])
  component Item @relation("ComponentToKit", fields: [componentId], references: [id])

  @@unique([kitId, componentId])
  @@map("kit_details")
}

model Disposal {
  id            String   @id @map("id")
  item          Item     @relation(fields: [id], references: [id])
  date          DateTime @map("date")
  reason        String   @map("reason")
  status        String   @map("status")
  responsibleId String   @map("responsible_id")
  responsible   Staff    @relation(fields: [responsibleId], references: [id])
  observations  String?  @map("observations")
  actions       String?  @map("actions")

  @@map("disposals")
}
