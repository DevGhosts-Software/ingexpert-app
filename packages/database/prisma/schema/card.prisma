model Card {
  id         String  @id @default(uuid())

  // ============================================================
  // CORE RELATIONS
  // ============================================================
  userId     String  @map("user_id")
  deckId     String  @map("deck_id")
  templateId String? @map("template_id") // For templated cards (optional)

  // ============================================================
  // CONTENT & MEDIA (What the user sees)
  // ============================================================
  front          String // Question/prompt
  back           String // Answer
  markdown       Boolean  @default(false) // Support markdown rendering
  frontMediaUrls String[] @default([]) @map("front_media_urls") // Image/audio URLs
  backMediaUrls  String[] @default([]) @map("back_media_urls")
  customFields   Json     @default("{}") @map("custom_fields") // For advanced users, templates

  // ============================================================
  // FSRS ALGORITHM STATE (Math & Logic)
  // ============================================================
  state      CardState @default(NEW)
  due        DateTime // When card is due for review
  stability  Float? // FSRS: memory strength (0-infinity)
  difficulty Float? // FSRS: inherent difficulty (1-10, default 5)
  reps       Int       @default(0) // Total reviews
  lapses     Int       @default(0) // Times failed
  
  // ============================================================
  // FLAGS & METADATA
  // ============================================================
  flag      Int     @default(0) // 0=None, 1=Red, 2=Orange, 3=Green, 4=Blue...
  leech     Boolean @default(false) // Auto-marked if lapses > threshold
  isArchived Boolean @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  siblingId String? @map("sibling_id") // ID to group cards from same source/note

  // ============================================================
  // SYNC METADATA (Managed by SyncService)
  // ============================================================
  version        Int      @default(0)
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")
  lastSyncedBy   String?  @map("last_synced_by")
  clientId       String?  @map("client_id") // Deduplication key
  syncStatus     String   @default("synced") @map("sync_status") // 'synced' | 'pending' | 'conflict'
  lastConflictAt DateTime? @map("last_conflict_at")
  conflictCount  Int       @default(0) @map("conflict_count")
  etag           String?
  syncBatchId    String?   @map("sync_batch_id")

  // ============================================================
  // TIMESTAMPS
  // ============================================================
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  firstReviewedAt DateTime? @map("first_reviewed_at")
  lastReviewedAt  DateTime? @map("last_reviewed_at")

  // ============================================================
  // RELATIONS
  // ============================================================
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  template  CardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reviews   Review[]
  syncStats CardSyncStats?
  tags      Tag[] // M:N junction
  cardNotes CardNote[]
  histories CardHistory[]
  embedding CardEmbedding?
  performanceSummary CardPerformanceSummary?

  @@index([userId, deckId])
  @@index([userId, deckId, due]) // 5x faster study load
  @@index([userId, etag])
  @@index([userId, due]) // Critical for "get cards due today"
  @@index([deckId, state])
  @@index([userId, lastReviewedAt])
  @@index([leech])
  @@index([siblingId])
  @@index([userId, isArchived])
  @@index([userId, deckId, state])
  @@index([userId, due, state])
  @@index([deckId, due, state]) // Deck review queue
  @@map("cards")
}

enum CardState {
  NEW        // Never reviewed
  LEARNING   // Reviewed but not mature (< 21 days since first review)
  REVIEW     // Mature card (>= 21 days)
  RELEARNING // Failed during review
  SUSPENDED  // User paused (permanent)
  BURIED     // Hidden until tomorrow (temporary)
}

model CardTemplate {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name        String // "Basic", "Cloze", "Image Occlusion", etc.
  description String?

  // Template structure (like Anki cloze format)
  frontTemplate String   @map("front_template")
  backTemplate  String   @map("back_template")
  fieldNames    String[] @default([]) @map("field_names") // ["Front", "Back"]
  css           String? // Custom CSS for cards

  isBuiltIn Boolean @default(false) @map("is_built_in")
  position  Int     @default(0)

  version      Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([userId, name])
  @@index([userId])
  @@map("card_templates")
}

model CardNote {
  id     String @id @default(uuid())
  cardId String @map("card_id")
  userId String @map("user_id") // For quick queries without joins

  content String // Markdown note

  version      Int      @default(0)
  synced       Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
  @@map("card_notes")
}

model Tag {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  name   String
  color  String?

  version      Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[] // M:N through junction table

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}