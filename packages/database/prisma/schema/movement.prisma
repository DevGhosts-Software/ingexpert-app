enum MovementType {
  ENTRY
  EXIT
}

model Movement {
  id                    String       @id @default(uuid())
  type                  MovementType @map("tipo")
  personal              String       @map("personal")
  destination           String?      @map("destino")
  responsibleDeliveryId String?      @map("id_responsable_entrega")
  responsibleReceiptId  String?      @map("id_responsable_recepcion")
  date                  DateTime     @map("fecha")
  projectId             String?      @map("id_proyecto")

  // Relations
  responsibleDelivery Staff?           @relation("ResponsableEntrega", fields: [responsibleDeliveryId], references: [id])
  responsibleReceipt  Staff?           @relation("ResponsableRecepcion", fields: [responsibleReceiptId], references: [id])
  project             Project?         @relation(fields: [projectId], references: [id])
  details             MovementDetail[]

  @@map("movements")
}

model MovementDetail {
  id         String  @id @default(uuid())
  movementId String  @map("id_movimiento")
  itemId     String  @map("id_item")
  quantity   Decimal @db.Decimal(10, 2) @map("cantidad")

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([movementId, itemId])
  @@map("movement_details")
}
