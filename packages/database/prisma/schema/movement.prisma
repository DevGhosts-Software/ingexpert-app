enum MovementType {
  EXIT
  PURCHASE
  RETURN
  WRITEOFF
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
}

model Movement {
  id                    String       @id @default(uuid())
  type                  MovementType @map("type")
  createdById           String       @map("created_by_id")
  destination           String?      @map("destination")
  observations          String?      @map("observations")
  responsibleDeliveryId String?      @map("responsible_delivery_id")
  responsibleReceiptId  String?      @map("responsible_receipt_id")
  date                  DateTime     @map("date")
  projectId             String?      @map("project_id")

  // Relations
  createdBy           User             @relation("MovementCreator", fields: [createdById], references: [id])
  responsibleDelivery User?            @relation("MovementDelivery", fields: [responsibleDeliveryId], references: [id])
  responsibleReceipt  User?            @relation("MovementReceipt", fields: [responsibleReceiptId], references: [id])
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  details             MovementDetail[]

  @@map("movements")
}

model MovementDetail {
  id         String  @id @default(uuid())
  movementId String  @map("movement_id")
  itemId     String  @map("item_id")
  quantity   Decimal @map("quantity") @db.Decimal(10, 2)

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([movementId, itemId])
  @@map("movement_details")
}
