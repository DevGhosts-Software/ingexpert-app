model CardHistory {
  id        String   @id @default(uuid())
  
  // ============================================================
  // CORE RELATIONS
  // ============================================================
  cardId    String   @map("card_id")
  userId    String   @map("user_id")
  
  // ============================================================
  // STATE CHANGE
  // ============================================================
  stateBefore CardState @map("state_before")
  stateAfter  CardState @map("state_after")
  
  // ============================================================
  // FSRS PROGRESSION
  // ============================================================
  stabilityBefore Float? @map("stability_before")
  stabilityAfter  Float? @map("stability_after")
  difficultyBefore Float? @map("difficulty_before")
  difficultyAfter Float? @map("difficulty_after")
  
  // ============================================================
  // REVIEW DETAILS
  // ============================================================
  rating Int // 1-4
  reviewTimeMs Int @map("review_time_ms")
  timestamp DateTime @default(now())
  
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([cardId, timestamp])
  @@index([userId, timestamp])
  @@map("card_histories")
}

model CardInterleavingGroup {
  id     String @id @default(uuid())
  userId String @map("user_id")
  deckId String @map("deck_id")
  
  // ============================================================
  // GROUP CONFIGURATION
  // ============================================================
  name String
  description String?
  strategyType String @default("spaced") // "random", "spaced", "mixed"
  maxSimultaneous Int @default(3) // Max cards from group at once
  cardIds String[] @map("card_ids")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@index([userId, deckId])
  @@map("card_interleaving_groups")
}

model CardEmbedding {
  id        String   @id @default(uuid())
  cardId    String   @unique @map("card_id")
  
  // ============================================================
  // VECTOR DATA
  // ============================================================
  // Vector embedding (1536 dims for OpenAI, 384 for Sentence Transformers)
  embedding Unsupported("vector(1536)") // PostgreSQL pgvector
  
  // ============================================================
  // RAG METADATA
  // ============================================================
  summary   String? // Brief LLM-generated summary
  keywords  String[] @default([]) // Extracted key concepts
  tokenCount Int @map("token_count") // For LLM context window optimization
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  @@index([cardId])
  @@map("card_embeddings")
}