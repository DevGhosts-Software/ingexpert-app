enum TipoItem {
  PRODUCTO
  EQUIPO
  HERRAMIENTA
  KIT
}

model Item {
  id        String   @id @default(uuid())
  nombre    String   @map("nombre")
  ubicacion String   @map("ubicacion")
  stock     Decimal  @default(0) @db.Decimal(10, 2) @map("stock")
  unidad    String   @map("unidad")
  tipo      TipoItem @map("tipo")

  // Relaciones
  baja           Baja?
  detallesKit    DetalleKit[]       @relation("KitAComponente")
  esComponenteDe DetalleKit[]       @relation("ComponenteAKit")
  detallesMovimiento DetalleMovimiento[]

  @@map("items")
}

model DetalleKit {
  id           String  @id @default(uuid())
  idKit        String  @map("id_kit")
  idComponente String  @map("id_item")
  cantidad     Decimal @db.Decimal(10, 2) @map("cantidad")

  kit        Item @relation("KitAComponente", fields: [idKit], references: [id])
  componente Item @relation("ComponenteAKit", fields: [idComponente], references: [id])

  @@unique([idKit, idComponente])
  @@map("detalles_kit")
}

model Baja {
  id             String   @id @map("id")
  item           Item     @relation(fields: [id], references: [id])
  fecha          DateTime @map("fecha")
  motivo         String   @map("motivo")
  estado         String   @map("estado")
  idResponsable  String   @map("id_responsable")
  responsable    Personal @relation(fields: [idResponsable], references: [id])
  observaciones  String?  @map("observaciones")
  acciones       String?  @map("acciones")

  @@map("bajas")
}
