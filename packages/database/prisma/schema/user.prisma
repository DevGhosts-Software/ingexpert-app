enum UserRole {
  USER
  ADMIN
}

model User {
  id       String   @id @default(uuid())
  
  // ============================================================
  // ACCOUNT & PROFILE
  // ============================================================
  email    String   @unique
  role     UserRole @default(USER)
  name     String?
  avatar   String?
  timezone String   @default("UTC")
  locale   String   @default("en")

  version      Int      @default(0)
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  // ============================================================
  // GLOBAL PREFERENCES
  // ============================================================
  preferredRetention Float   @default(0.9) @map("preferred_retention")
  darkMode           Boolean @default(false)
  metadata           Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ============================================================
  // CORE RELATIONS
  // ============================================================
  decks         Deck[]
  cards         Card[]
  reviews       Review[]
  cardTemplates CardTemplate[]
  tags          Tag[]
  collections   Collection[]
  sharedDecks   SharedDeck[]
  notifications Notification[]
  studySessions StudySession[]
  
  // ============================================================
  // SYNC RELATIONS
  // ============================================================
  syncLogs           SyncLog[]
  syncConflicts      SyncConflict[]
  clientStates       ClientState[]
  syncBatches        SyncBatch[]
  syncStatusSnapshots SyncStatusSnapshot[]
  cardSyncStats      CardSyncStats[]
  
  // ============================================================
  // EXTENSIONS & ANALYTICS
  // ============================================================
  userStats     UserStats?
  learningProfile UserLearningProfile?
  dailyStats UserDailyStats[]
  deckDailyStats DeckDailyStats[]
  cardPerformances CardPerformanceSummary[]
  cardHistories CardHistory[]
  learningPaths CardLearningPath[]
  anomalies LearningAnomaly[]
  recommendations StudyRecommendation[]
  concepts Concept[]

  @@index([email])
  @@map("users")
}

model UserStats {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  
  // ============================================================
  // AGGREGATE STATS
  // ============================================================
  totalCards     Int       @default(0) @map("total_cards")
  totalReviews   Int       @default(0) @map("total_reviews")
  totalDecks     Int       @default(0) @map("total_decks")
  totalStudyTime Int       @default(0) @map("total_study_time") // in seconds
  
  // ============================================================
  // STREAK & ACTIVITY
  // ============================================================
  streakDays     Int       @default(0) @map("streak_days")
  lastReviewAt   DateTime? @map("last_review_at")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}