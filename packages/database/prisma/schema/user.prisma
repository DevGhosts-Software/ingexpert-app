enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())

  // ============================================================
  // ACCOUNT & PROFILE
  // ============================================================
  email  String   @unique
  role   UserRole @default(USER)
  name   String?
  avatar String?

  staff Staff?

  createdMovements      Movement[] @relation("MovementCreator")
  deliveredMovements    Movement[] @relation("MovementDelivery")
  receivedMovements     Movement[] @relation("MovementReceipt")

  @@index([email])
  @@map("users")
}

model Staff {
  id String @id

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  workArea String? @map("work_area")

  // Relations
  disposals          Disposal[]

  @@map("staff")
}
