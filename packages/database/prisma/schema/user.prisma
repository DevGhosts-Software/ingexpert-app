enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())

  // ============================================================
  // ACCOUNT & PROFILE
  // ============================================================
  email   String   @unique
  role    UserRole @default(USER)
  name    String?
  avatar  String?
  hasAuth Boolean  @default(true)

  staff Staff?

  createdMovements      Movement[] @relation("MovementCreator")
  deliveredMovements    Movement[] @relation("MovementDelivery")
  receivedMovements     Movement[] @relation("MovementReceipt")

  @@index([email])
  @@map("users")
}

model WorkArea {
  id   String @id @default(uuid())
  name String @unique

  staff Staff[]

  @@map("work_areas")
}

model Staff {
  id         String  @id
  workAreaId String? @map("work_area_id")

  user     User      @relation(fields: [id], references: [id], onDelete: Cascade)
  workArea WorkArea? @relation(fields: [workAreaId], references: [id], onDelete: SetNull)

  // Relations
  disposals Disposal[]

  @@map("staff")
}
