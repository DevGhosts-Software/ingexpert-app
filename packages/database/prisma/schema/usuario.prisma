enum RolUsuario {
  USUARIO
  ADMIN
}

model Usuario {
  id String @id @default(uuid())

  // ============================================================
  // CUENTA Y PERFIL
  // ============================================================
  email  String     @unique
  rol    RolUsuario @default(USUARIO)
  nombre String?
  avatar String?

  personal Personal?

  @@index([email])
  @@map("usuarios")
}

model Personal {
  id String @id

  usuario Usuario @relation(fields: [id], references: [id], onDelete: Cascade)

  areaTrabajo String? @map("area_trabajo")

  // Relaciones
  movimientosEntregados Movimiento[] @relation("ResponsableEntrega")
  movimientosRecibidos  Movimiento[] @relation("ResponsableRecepcion")
  bajas                 Baja[]

  @@map("personal")
}
