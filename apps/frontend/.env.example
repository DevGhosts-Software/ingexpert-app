# Port number for the web application
PORT=3000

# API URL for tRPC transport.
# You can provide either:
# - API origin only (e.g. http://localhost:3001), runtime appends /trpc
# - Full tRPC URL (e.g. http://localhost:3001/trpc)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (for Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_ANON_KEY"
# PowerSync
NEXT_PUBLIC_POWERSYNC_URL=http://localhost:8080
