# Supabase/PostgreSQL datasource used by PowerSync replication.
PS_DATA_SOURCE_URI=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# MongoDB storage URI used by PowerSync service.
# Local docker-compose default uses replica set mode.
PS_MONGO_URI=mongodb://mongo:27017/powersync?replicaSet=rs0

# PowerSync service port exposed by docker-compose.
PS_PORT=8080

# Supabase JWKS endpoint used by PowerSync to validate Supabase access tokens.
PS_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
